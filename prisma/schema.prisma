// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output = "../api/generated/client"

}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Expense {
  id      String    @id @db.ObjectId @default(auto()) @map("_id")
  createdAt   DateTime   @default(now())
  description   String
  client  String
  paymentMethod String
  amount  Float
  employee  User @relation(fields: [employeeId], references: [id], onDelete:Cascade)
  employeeId  String @db.ObjectId
  Status  String
  taxAmount   Float?
  category  String
  location  String

}

model User {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  comment  Comment[]
  likes    Like[]
  password String
  post     Post[]
  expense  Expense[]
  melting  Melting[]
  making    Making[]
  customer  Customer[]
}

model Post {
  id      String    @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  body    String
  comment Comment[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId  
}

model Comment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.ObjectId
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String    @db.ObjectId
  parent    Comment?  @relation("ParentChild", onDelete: NoAction, onUpdate: NoAction, fields: [parentId], references: [id])
  children  Comment[] @relation("ParentChild")
  parentId  String?   @db.ObjectId
  likes     Like[]
}

model Like {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String  @db.ObjectId
  count     Int     @default(0)
}

model Customer{
  id  String  @id@default(auto()) @map("_id") @db.ObjectId
  type String
  name  String
  Balance Float @default(0)
  Part  String 
  item  Item[]
  collection  Collection[]
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @db.ObjectId
}

model Item{
  id String   @id@default(auto()) @map("_id") @db.ObjectId
  type  String
  name  String
  Item_wgt  Float
  Pure_wgt  Float
  Touch Float
  createdAt DateTime  @default(now())
  Testing_wgt Float
  Return_wgt  Float?
  Remark  String?
  customer  Customer  @relation(fields: [customerId],references: [id])
  customerId  String  @db.ObjectId

}

model Melting{
  id  String @id@default(auto())  @map("_id") @db.ObjectId
  Purpose String
  Ghatti_wgt  Int
  Pure_wgt  Int
  Melted_wgt  Int
  Chura_wgt   Int
  createdAt   DateTime  @default(now())
  Remark  String?
  user  User  @relation(fields: [userId],references: [id])
  userId  String    @db.ObjectId
}

model Making{
  id  String  @id @map("_id") @default(auto()) @db.ObjectId
  Making_Item String  
  Intial_wgt  Int
  Wastage_wgt Int
  createdAt     DateTime  @default(now())
  Remark  String?
  addon   AddOn[]
  user  User  @relation(fields: [userId],references: [id])
  userId  String    @db.ObjectId
}

model Collection{
  id  String  @id @map("_id") @default(auto()) @db.ObjectId
  type  String
  Ghatti_wgt  Int
  Pure_wgt    Int
  Remark  String?
  createdAt   DateTime  @default(now())
  customer  Customer  @relation(fields: [customerId],references: [id])
  customerId  String  @db.ObjectId
}
model AddOn{
  id    String  @id @map("_id")  
  Intial_wgt  Int
  final_wgt   Int
  Lost_wgt   Int?
  Remark  String?
  making  Making  @relation(fields: [making_id],references: [id])
  making_id String  @db.ObjectId
}